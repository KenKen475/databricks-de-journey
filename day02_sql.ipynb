   "source": [
    "--Testing LAG(col)\n",
    "\n",
    "SELECT\n",
    "  o_custkey,\n",
    "  o_orderkey,\n",
    "  o_orderdate,\n",
    "  LAG(o_orderdate) OVER (\n",
    "    PARTITION BY o_custkey\n",
    "    ORDER BY o_orderdate, o_orderkey\n",
    "  ) AS prev_order_date\n",
    "FROM samples.tpch.orders\n",
    "WHERE o_custkey = 1\n",
    "ORDER BY o_orderdate, o_orderkey;"
   ]
